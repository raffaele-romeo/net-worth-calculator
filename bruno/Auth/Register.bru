meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "john",
    "password": "secret123"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("token", res.getBody());
  }
}
