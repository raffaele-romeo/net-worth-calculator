meta {
  name: Create Transaction
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "month": 4,
    "year": 2026,
    "transactions": [
      {
        "amount": 1500.00,
        "currency": "USD",
        "assetId": 1
      },
      {
        "amount": 2000.00,
        "currency": "EUR",
        "assetId": 2
      }
    ]
  }
}
